RewriteEngine on

RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule (.*) https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^axis.sk$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www.axis.sk$
RewriteCond %{REQUEST_URI} !public/
RewriteRule (.*) /public/$1 [L]

Redirect 301 /efektivnejsie-osvetlenie.html /led-osvetlenie
Redirect 301 /fotovoltaika-a-tepelne-cerpadla.html /